<script>
function mainGroup(num){
		var formStr = "";	
		randNo = Math.floor((Math.random() * (999999 - 1 + 1)) + 1);		
		jQuery.ajax({
			type: "POST",
			data: "num="+num+"&random="+randNo,
			url: "/pc/main/main_group.asp",
			dataType : "HTML",
			success: function(data) {
				formStr = data;			
				jQuery(".groupBtn").removeClass("on");
				jQuery(".q" + num + "p").addClass("on");
				jQuery("#groupList").hide().empty().fadeIn().append(data);
				
				setTimeout(function(){
					try{
					var mySwiper = document.querySelector('.goods__slider').swiper;				
					mySwiper.slideTo(0, 0, false);
					}catch(e){
					}
				}, 100);
			},
			error: function(e) {
				//alert("e");
			}
		});
}
</script>
		
